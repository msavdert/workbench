# Defaults for providers/orbstack/create-vm.sh. Every value can be overridden
# from the environment. OrbStack limits are caps, not reservations, so the
# reference 4 vCPU stays; memory and disk are sized for a 16 GB laptop and
# the disk is thin (grows on use).
VM_NAME="${VM_NAME:-agent-vm}"
VM_USER="${VM_USER:-agent}"
VM_DISTRO="${VM_DISTRO:-ubuntu:noble}"
VM_CPUS="${VM_CPUS:-4}"
VM_MEMORY="${VM_MEMORY:-8G}"
VM_DISK="${VM_DISK:-100G}"
