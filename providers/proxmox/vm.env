# Proxmox-side parameters for the agent VM. Sourced by create-vm.sh on the
# PVE host. Everything here is deliberately plain shell so it can be overridden
# from the environment: VMID=106 ./create-vm.sh
VMID="${VMID:-105}"
VM_NAME="${VM_NAME:-agent-vm}"
VM_CORES="${VM_CORES:-4}"
VM_MEMORY_MB="${VM_MEMORY_MB:-32768}"
VM_DISK_GB="${VM_DISK_GB:-200}"
VM_BRIDGE="${VM_BRIDGE:-vnet0}"           # PVE SDN vnet, NAT zone localnat, 10.0.0.0/24
VM_IP_CIDR="${VM_IP_CIDR:-10.0.0.11/24}"  # static, outside the SDN DHCP range (.100-.200)
VM_GATEWAY="${VM_GATEWAY:-10.0.0.1}"
VM_DNS="${VM_DNS:-1.1.1.1 1.0.0.1}"
VM_STORAGE="${VM_STORAGE:-local-zfs}"     # zfspool: thin, snapshots, discard passthrough
SNIPPET_STORAGE="${SNIPPET_STORAGE:-local}"
SNIPPET_DIR="${SNIPPET_DIR:-/var/lib/vz/snippets}"
SNIPPET_NAME="${SNIPPET_NAME:-agent-vm-cloud-init.yaml}"
IMAGE_URL="${IMAGE_URL:-https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img}"
IMAGE_SUMS_URL="${IMAGE_SUMS_URL:-https://cloud-images.ubuntu.com/noble/current/SHA256SUMS}"
IMAGE_DIR="${IMAGE_DIR:-/var/lib/vz/template/iso}"
VM_TAGS="${VM_TAGS:-agent;ubuntu-24.04}"
