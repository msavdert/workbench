#!/usr/bin/env bash
# opwith <env-name> <command...>  (home/bin, linked to ~/.local/bin by home/install.sh)
# Run <command> with the secrets listed in $OP_ENV_DIR/<env-name>.env resolved
# from 1Password and injected into that one process only.
#   opwith git gh repo list
# The .env files contain only op:// references and are safe to version.
set -euo pipefail
OP_ENV_DIR="${OP_ENV_DIR:-$HOME/.config/op-env}"
name="${1:?usage: opwith <env-name> <command...>}"; shift
env_file="$OP_ENV_DIR/$name.env"
[[ -f $env_file ]] || { echo "opwith: no such env file: $env_file" >&2; exit 1; }
exec op run --no-masking --env-file="$env_file" -- "$@"
