# op run --env-file target: failure notices from the box (notify-telegram)
# Only op:// references here; the values are the personal hermes bot's token
# and the operator's home chat id, the same items env.agent.tpl renders for
# the gateway. Consumed by unit-failure-notify@.service via `opwith notify`.
TELEGRAM_BOT_TOKEN=op://dotfiles/Hermes/telegram-bot-melih
TELEGRAM_HOME_CHANNEL=op://dotfiles/Hermes/telegram-home-melih
