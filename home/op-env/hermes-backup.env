# =============================================================================
# op run --env-file target: hermes nightly backup (hermes-backup.py)
# =============================================================================
# Consumed by the hermes-backup systemd user unit via `opwith hermes-backup`.
# Only op:// references here; secrets resolve at runtime, on every run, and
# never land on disk. The age RECIPIENT is a public key; the matching private
# identity stays in the Hermes item in 1Password and is only needed to restore.
#
# Usage: opwith hermes-backup uv run ~/.hermes/hermes-backup.py
# =============================================================================

S3_ENDPOINT=op://dotfiles/OCI S3 Bucket/s3-url
S3_REGION=op://dotfiles/OCI S3 Bucket/s3-region
S3_BUCKET=general
S3_PREFIX=hermes/backup/
S3_ACCESS_KEY_ID=op://dotfiles/OCI S3 Bucket/s3-key
S3_SECRET_ACCESS_KEY=op://dotfiles/OCI S3 Bucket/s3-secret
AGE_RECIPIENTS=op://dotfiles/Hermes/age-recipient
RETENTION_DAYS=30
LOCAL_KEEP=7
BACKUP_LABEL=hermes
