{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "env": {
    "NO_COLOR": "1",
    "PAGER": "cat",
    "GIT_PAGER": "cat",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "8"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 1,
    "refreshInterval": 3
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "h=$HOME/.claude/hooks/boundary-gate.sh; [ -x \"$h\" ] && exec bash \"$h\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
