#!/usr/bin/env bash
# remote-add <name> [git-url] [--worktree] [--capacity N] [--permission-mode M] [--no-start]
#
# Make ~/work/<name> a Claude Code Remote Control environment: clone it if a
# URL is given and the directory does not exist, pre-accept the workspace
# trust dialog for that path, then enable + start claude-remote@<name>.
# Runs on the VM as the agent user; safe to re-run.
#
#   remote-add suhuf https://github.com/msavdert/suhuf.git
#   remote-add suhuf --worktree          # each app session gets its own git worktree
#   remote-add scratch                   # empty dir, no repo
#   --no-start: clone + trust + enable only; do not (re)start the server now
set -euo pipefail

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }
name=""; url=""; spawn=""; capacity=""; pmode=""; start=1
while [[ $# -gt 0 ]]; do
  case $1 in
    --worktree) spawn=worktree ;;
    --same-dir) spawn=same-dir ;;
    --capacity) capacity=${2:?}; shift ;;
    --permission-mode) pmode=${2:?}; shift ;;
    --no-start) start=0 ;;
    -h|--help) usage ;;
    -*) echo "unknown option: $1" >&2; usage ;;
    *) if [[ -z $name ]]; then name=$1; elif [[ -z $url ]]; then url=$1; else usage; fi ;;
  esac
  shift
done
[[ -n $name ]] || usage
[[ $name =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "name must match [A-Za-z0-9_.-]+" >&2; exit 1; }

dir="$HOME/work/$name"
if [[ ! -d $dir ]]; then
  if [[ -n $url ]]; then
    git clone "$url" "$dir"
  else
    mkdir -p "$dir"
    echo "created empty $dir (no url given)"
  fi
elif [[ -n $url ]]; then
  echo "$dir exists, not cloning"
fi

# workspace trust for this exact path (Claude refuses to start otherwise)
cj="$HOME/.claude.json"
[[ -f $cj ]] || echo '{}' >"$cj"
jq --arg d "$dir" '.projects[$d] = ((.projects[$d] // {}) + {hasTrustDialogAccepted: true}) | .remoteDialogSeen = true | .hasCompletedOnboarding = true' \
  "$cj" >"$cj.tmp" && mv "$cj.tmp" "$cj" && chmod 600 "$cj"

# per-project overrides for the template unit
if [[ -n $spawn || -n $capacity || -n $pmode ]]; then
  mkdir -p "$HOME/.config/claude-remote"
  envf="$HOME/.config/claude-remote/$name.env"
  touch "$envf"
  [[ -n $spawn ]]    && { grep -v '^CLAUDE_REMOTE_SPAWN=' "$envf" >"$envf.tmp" || true; echo "CLAUDE_REMOTE_SPAWN=$spawn" >>"$envf.tmp"; mv "$envf.tmp" "$envf"; }
  [[ -n $capacity ]] && { grep -v '^CLAUDE_REMOTE_CAPACITY=' "$envf" >"$envf.tmp" || true; echo "CLAUDE_REMOTE_CAPACITY=$capacity" >>"$envf.tmp"; mv "$envf.tmp" "$envf"; }
  [[ -n $pmode ]]    && { grep -v '^CLAUDE_REMOTE_PERMISSION_MODE=' "$envf" >"$envf.tmp" || true; echo "CLAUDE_REMOTE_PERMISSION_MODE=$pmode" >>"$envf.tmp"; mv "$envf.tmp" "$envf"; }
fi

systemctl --user daemon-reload
if [[ ! -f $HOME/.claude/.credentials.json ]]; then
  # enable only: the unit starts at next boot / after `claude auth login`
  systemctl --user enable "claude-remote@$name.service" >/dev/null 2>&1
  echo "claude-remote@$name: enabled, not started (no Claude credentials yet - run: claude auth login; systemctl --user start claude-remote@$name)"
  exit 0
fi
if [[ $start == 0 ]]; then
  systemctl --user enable "claude-remote@$name.service" >/dev/null 2>&1
  echo "claude-remote@$name: enabled (--no-start)"
  exit 0
fi
systemctl --user enable --now "claude-remote@$name.service" >/dev/null
# a restart picks up env changes on re-runs
systemctl --user restart "claude-remote@$name.service"
sleep 3
if systemctl --user is-active --quiet "claude-remote@$name.service"; then
  echo "claude-remote@$name: active  ($dir)"
  journalctl --user -u "claude-remote@$name" -o cat -n 40 --no-pager 2>/dev/null | grep -m1 -oE 'https://claude\.ai/code\?environment=[A-Za-z0-9_]+' || true
else
  echo "claude-remote@$name: FAILED" >&2
  journalctl --user -u "claude-remote@$name" -o cat -n 15 --no-pager >&2
  exit 1
fi
