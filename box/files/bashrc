# ~/.bashrc for the agent user. Managed by agent-vm/provision - edit there.
#
# Design: this shell is driven by AI agents far more often than by a human.
# Everything that could inject noise into a tool's output (fancy prompts,
# colours, pagers, editors that wait for a keypress) is off. Human comfort is
# not the goal; predictable, plain, non-blocking output is.

# --- always (interactive or not) -------------------------------------------
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
# mise shims put every managed tool on PATH even for `ssh host cmd` and cron.
command -v mise >/dev/null && eval "$(mise activate bash --shims)"

# 1Password: service-account token lives in ~/.config/op/env (0600, env-file
# format, `OP_SERVICE_ACCOUNT_TOKEN=ops_...`), pushed by `make secrets`. The
# same file feeds claude-remote.service via EnvironmentFile.
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -r "$HOME/.config/op/env" ]; then
  set -a; . "$HOME/.config/op/env"; set +a
fi
export OP_ENV_DIR="$HOME/.config/op-env"

# non-interactive, non-blocking defaults
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
export PAGER=cat
export GIT_PAGER=cat
export SYSTEMD_PAGER=
export SYSTEMD_COLORS=0
export LESS=-FRX
export EDITOR=vim
export VISUAL=vim
export NO_COLOR=1
export CLICOLOR=0
export TERM="${TERM:-xterm-256color}"
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export PYTHONDONTWRITEBYTECODE=1
export PIP_DISABLE_PIP_VERSION_CHECK=1
export UV_LINK_MODE=copy
export npm_config_fund=false
export npm_config_update_notifier=false
export DOCKER_CLI_HINTS=false
export HOMEBREW_NO_ANALYTICS=1
# DO_NOT_TRACK is deliberately NOT set: Claude Code Remote Control refuses to
# start with it ("requires feature-flag evaluation").

# --- interactive only -------------------------------------------------------
# Everything below this guard never runs for a non-interactive shell, which
# is exactly how Claude Code's Bash tool, `ssh host cmd`, and cron invoke
# bash. That is what makes the colour below safe: it exists only for a human
# at a real terminal (SSH in as agent@agent-vm) and never reaches agent tool
# output, which stays governed by NO_COLOR/CLICOLOR above.
case $- in *i*) ;; *) return ;; esac

# full mise activation (PATH updates on `cd`, per-project .mise.toml)
command -v mise >/dev/null && eval "$(mise activate bash)"

# badge in the Claude Code statusline (see claude-statusline.sh's SL_BADGE_CMD
# knob), so a session started here is identifiable if this repo is ever
# reused to stand up another VM.
export SL_BADGE_CMD='hostname -s'

# colour for human eyes only (see guard above); still single line, no git
# status in the prompt itself - keep this cheap, it runs on every prompt.
unset NO_COLOR
export CLICOLOR=1
PS1='\[\033[38;5;71m\]\u@\h\[\033[0m\]:\[\033[38;5;74m\]\w\[\033[0m\]\$ '
alias ls='ls --color=auto'
alias grep='grep --color=auto'

HISTSIZE=100000
HISTFILESIZE=200000
HISTCONTROL=ignoredups
HISTTIMEFORMAT='%F %T '
shopt -s histappend checkwinsize
PROMPT_COMMAND='history -a'

alias ll='ls -la'
alias la='ls -A'
alias dc='docker compose'

# bash completion is useful for humans, harmless for agents
if ! shopt -oq posix && [ -f /usr/share/bash-completion/bash_completion ]; then
  . /usr/share/bash-completion/bash_completion
fi
