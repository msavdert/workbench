# ~/.bashrc for the agent user (box/files, installed by box/bootstrap.sh).
#
# Design: this shell is driven by AI agents far more often than by a human.
# Everything that could inject noise into a tool's output (fancy prompts,
# colours, pagers, editors that wait for a keypress) is off. Human comfort is
# not the goal; predictable, plain, non-blocking output is.

# --- always (interactive or not) -------------------------------------------
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
# profile marker written by home/install.sh box: MISE_ENV=box makes mise load
# config.box.toml next to the shared config.toml (D6), for agents too.
[ -r "$HOME/.config/workbench/env" ] && . "$HOME/.config/workbench/env"
# mise shims put every managed tool on PATH even for `ssh host cmd` and cron.
command -v mise >/dev/null && eval "$(mise activate bash --shims)"

# 1Password: service-account token lives in ~/.config/op/env (0600, env-file
# format, `OP_SERVICE_ACCOUNT_TOKEN=ops_...`), pushed by `make secrets`. The
# same file feeds claude-remote.service via EnvironmentFile.
if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] && [ -r "$HOME/.config/op/env" ]; then
  set -a; . "$HOME/.config/op/env"; set +a
fi
export OP_ENV_DIR="$HOME/.config/op-env"

# non-interactive, non-blocking defaults
export DEBIAN_FRONTEND=noninteractive
export NEEDRESTART_MODE=a
export PAGER=cat
export GIT_PAGER=cat
export SYSTEMD_PAGER=
export SYSTEMD_COLORS=0
export LESS=-FRX
export EDITOR=vim
export VISUAL=vim
export NO_COLOR=1
export CLICOLOR=0
export TERM="${TERM:-xterm-256color}"
export LANG=C.UTF-8
export LC_ALL=C.UTF-8
export PYTHONDONTWRITEBYTECODE=1
export PIP_DISABLE_PIP_VERSION_CHECK=1
export UV_LINK_MODE=copy
export npm_config_fund=false
export npm_config_update_notifier=false
export DOCKER_CLI_HINTS=false
export HOMEBREW_NO_ANALYTICS=1
# DO_NOT_TRACK is deliberately NOT set: Claude Code Remote Control refuses to
# start with it ("requires feature-flag evaluation").

# --- interactive only -------------------------------------------------------
# Everything below this guard never runs for a non-interactive shell, which
# is exactly how Claude Code's Bash tool, `ssh host cmd`, and cron invoke
# bash. Everything a human wants (colour, prompt, aliases, the hand-off to
# zsh) lives in home/bash/interactive.sh so that nothing rich is even
# present in this file (D5). Agent shells return here.
case $- in *i*) ;; *) return ;; esac

[ -r "$HOME/.config/bash/interactive.sh" ] && . "$HOME/.config/bash/interactive.sh"
