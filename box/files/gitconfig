# ~/.gitconfig for the agent user. Managed by agent-vm/provision.
[user]
	name = msavdert
	email = msavdert@users.noreply.github.com
[init]
	defaultBranch = main
[core]
	pager = cat
	editor = vim
	autocrlf = input
[color]
	ui = never
[pull]
	ff = only
[push]
	autoSetupRemote = true
	default = current
[fetch]
	prune = true
[rebase]
	autoStash = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
[advice]
	detachedHead = false
# HTTPS credentials come from 1Password on every use; no token on disk and no
# dependency on `gh auth login`. Needs OP_SERVICE_ACCOUNT_TOKEN in the env.
[credential "https://github.com"]
	helper =
	helper = "!f() { test \"$1\" = get && printf 'username=x-access-token\\npassword=%s\\n' \"$(op read op://dotfiles/GitHub/admintoken)\"; }; f"
[credential "https://gist.github.com"]
	helper =
	helper = "!f() { test \"$1\" = get && printf 'username=x-access-token\\npassword=%s\\n' \"$(op read op://dotfiles/GitHub/admintoken)\"; }; f"
