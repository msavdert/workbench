# =============================================================================
# op run --env-file target: GitHub
# =============================================================================
# `git` itself never needs this: configs/git/config resolves its GitHub HTTPS
# credential directly from 1Password on every invocation, with no token in
# the environment and no dependency on `gh auth login`. This env file is only
# for the `gh` CLI's own commands (pr/issue/repo management), which do read
# GH_TOKEN/GITHUB_TOKEN from the environment.
#
# Usage:  opwith git gh repo list
# =============================================================================

GH_TOKEN=op://dotfiles/GitHub/admintoken
GITHUB_TOKEN=op://dotfiles/GitHub/admintoken
